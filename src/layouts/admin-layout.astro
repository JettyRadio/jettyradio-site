---
import { backstagePages } from '../lib/backstage/navigation'
import RootLayout from './root-layout.astro'
import { Show, SignInButton } from '@clerk/astro/components'
import Header from '../components/header.astro'
const page = backstagePages.find(page => page.href === Astro.url.pathname.replace(/\/$/, ''))
const title = `${page?.title || 'Upload show'} | Jetty Backstage`
---

<RootLayout title={title}>
    <Header backstage />
    <div class="backstage-shell">
        <Show when="signed-in">
            <div class="backstage-content"><slot /></div>
        </Show>
        <Show when="signed-out">
            <div class="hero min-h-screen">
                <div class="hero-content text-center">
                    <div class="max-w-md">
                        <h1 class="text-5xl font-bold">Jetty Backstage</h1>
                        <p class="py-6">
                            Sign in with your invited account to review submissions, prepare broadcasts, and manage the station library.
                        </p>
                        <SignInButton mode="modal" class:list="btn btn-primary" />
                    </div>
                </div>
            </div>
        </Show>
    </div>
</RootLayout>
