---
import AdminLayout from '../../layouts/admin-layout.astro'
---
<AdminLayout>
 <main id="desk" class="desk" data-api={import.meta.env.PUBLIC_DESK_API_URL || ''}>
  <header class="desk-heading"><div><p class="desk-kicker">BACKSTAGE 𒀭 PROGRAMMING</p><h1>Scheduling Desk</h1><p>Review this week’s episodes and schedule them in AzuraCast.</p></div></header>
  <nav class="workflow-links" aria-label="Scheduling resources"><a href="/backstage/submissions">Review submissions</a><a href="/backstage/episodes">Find uploaded episodes</a><a href="/backstage/djs">Look up a DJ or show</a></nav>
  <div class="desk-toolbar"><div class="desk-week-navigation"><label>Week beginning <input id="desk-week" class="input input-bordered" type="date" required/></label><button id="desk-previous-week" type="button" class="btn btn-outline" aria-label="Previous week" title="Previous week">←</button><button id="desk-next-week" type="button" class="btn btn-outline" aria-label="Next week" title="Next week">→</button></div><span>Pacific time · America/Los_Angeles</span><button id="desk-add" class="btn btn-accent" disabled>Add episode</button></div>
  <div class="desk-readiness-tools"><label>Find a show<input id="desk-search" type="search" class="input" placeholder="Show or artist" /></label><label>Show episodes<select id="desk-filter" class="select"><option value="all">All episodes</option><option value="needs-work">Needs preparation</option><option value="scheduled">Scheduled</option><option value="aired">Past slots · review archive</option><option value="archived">Archived</option></select></label><button id="desk-clear-filters" type="button" class="btn btn-outline">Clear filters</button></div>
  <p id="desk-status" role="status" aria-live="polite">Connecting to the desk…</p>
  <div class="desk-columns"><section class="desk-panel" aria-labelledby="week-heading"><div class="desk-section-heading"><h2 id="week-heading">This week</h2><span id="desk-count"></span></div><p id="desk-summary" class="desk-small"></p><p class="desk-small desk-readiness-note">Readiness reflects saved Desk records. Open an episode to confirm its current state in AzuraCast.</p><div id="desk-shows"></div></section><aside class="desk-sidebar"><section class="desk-panel desk-resources" aria-labelledby="sources-heading"><h2 id="sources-heading">Submission sources</h2><a class="link" href="https://docs.google.com/spreadsheets/d/1JWANaTg7HKQzrEQyqv1Y5ksioj-4sqUfu6-IBRDjwXw/edit" target="_blank" rel="noreferrer">Episode responses ↗</a><a class="link" href="/schedule" target="_blank" rel="noreferrer">Published calendar ↗</a><a class="link" href="https://stream.jettyradio.com/dashboard" target="_blank" rel="noreferrer">Open AzuraCast ↗</a></section>
  </aside></div>
  <dialog id="desk-editor" class="modal"><div class="modal-box desk-editor">
   <div class="desk-section-heading"><div><p class="desk-kicker">EPISODE SCHEDULING</p><h2 id="editor-heading">Review episode</h2><p id="desk-episode-summary" class="desk-small"></p></div><button id="desk-close" type="button" class="btn btn-ghost" aria-label="Close episode review">✕</button></div>
   <form id="desk-form">
<details id="desk-section-1" class="desk-section" open><summary><span class="desk-step-number">1</span><span><span class="desk-step-title">Episode details</span><span id="desk-progress-1" class="desk-step-hint">Confirm the show and air time</span></span><span class="desk-expand" aria-hidden="true">+</span></summary>    <fieldset class="desk-step"><legend class="sr-only">Episode details</legend><div class="desk-fields"><label>Show name<input name="title" class="input" required maxlength="1000"/></label><label>Artist name<input name="artist" class="input" required maxlength="1000"/></label></div><p class="desk-small">Check this episode against the published calendar and confirm any changes with the resident.</p><div class="desk-fields"><label>Air date<input name="date" type="date" class="input" required/></label><label>Start time · Pacific<input name="start" type="time" class="input" required/></label><label>End time · Pacific<input name="end" type="time" class="input" required/></label></div><input name="dateConfirmed" type="checkbox" hidden/><details><summary>Assignment & notes</summary><label>Assigned scheduler<input name="owner" class="input" maxlength="1000"/></label><label>Internal scheduling notes<textarea name="notes" class="textarea" rows="3" maxlength="5000"></textarea></label></details></fieldset></details>
<details id="desk-section-2" class="desk-section"><summary><span class="desk-step-number">2</span><span><span class="desk-step-title">Episode audio</span><span id="desk-progress-2" class="desk-step-hint">Upload or retrieve the MP3</span></span><span class="desk-expand" aria-hidden="true">+</span></summary>
<fieldset class="desk-step"><legend class="sr-only">Episode audio</legend>
<div class="desk-audio-sources" role="group" aria-label="Choose an audio source">
<button id="desk-source-drive" type="button" class="btn btn-outline" aria-pressed="true" aria-controls="desk-source-panel-drive">From Google Drive</button>
<button id="desk-source-computer" type="button" class="btn btn-outline" aria-pressed="false" aria-controls="desk-source-panel-computer">From computer</button>
<button id="desk-source-existing" type="button" class="btn btn-outline" aria-pressed="false" aria-controls="desk-source-panel-existing">Already in AzuraCast</button>
</div>
<label>Episode MP3 link <span id="desk-audio-link-hint" class="desk-small">Google Drive link to the episode MP3.</span><input name="audio" type="url" class="input" placeholder="https://drive.google.com/…" aria-describedby="desk-audio-link-hint"/></label>
<a id="desk-audio-link" class="link" target="_blank" rel="noreferrer" hidden>Open episode audio ↗</a>
<details id="desk-file-settings"><summary>File name & upload details</summary><label>MP3 name in AzuraCast<input name="uploadName" class="input" maxlength="176" required aria-describedby="desk-filename" placeholder="Show name - YYYY-MM-DD"/></label><p class="desk-small">Choose a name you’ll recognize in AzuraCast. A unique suffix prevents duplicate uploads from replacing each other.</p><p id="desk-filename" class="desk-small desk-filename"></p></details>
<div id="desk-source-panel-drive"><div class="desk-import-row"><button id="desk-import" type="button" class="btn btn-outline">Upload MP3 from episode link</button><p id="desk-import-status" role="status" aria-live="polite"></p></div></div>
<div id="desk-source-panel-computer" hidden><p class="desk-small">If Drive asks you to sign in, download the MP3 from the episode link and choose it here.</p><input id="desk-upload-file" type="file" accept=".mp3,audio/mpeg" class="file-input" aria-label="Downloaded episode MP3"/><button id="desk-upload" type="button" class="btn btn-outline" disabled>Upload episode MP3</button></div>
<div id="desk-source-panel-existing" hidden><div id="desk-existing"><p class="desk-small">Find the matching MP3 by filename, show, or artist. The original submission link is optional for existing files. Attach an upload to finish scheduling, or reconcile an episode managed directly in AzuraCast.</p><button id="desk-find-audio" type="button" class="btn btn-outline">Find uploaded MP3s</button><label>Filter by filename, show, or artist<input id="desk-audio-search" type="search" class="input" placeholder="Show name or air date"/></label><label>Existing MP3<select id="desk-existing-audio" class="select"><option value="">Find uploaded MP3s first</option></select></label><button id="desk-use-audio" type="button" class="btn btn-outline" disabled>Use selected MP3</button><label>Existing show playlist<select id="desk-reconcile-playlist" class="select"><option value="">Find uploaded MP3s first</option></select></label><p class="desk-small">Confirm the air date in step 1, then reconcile. This checks playlist membership and saves the current state in the desk without changing AzuraCast. To archive this episode, use its Archive button in the weekly schedule.</p><button id="desk-reconcile" type="button" class="btn btn-outline" disabled>Reconcile with AzuraCast</button></div></div>
<p id="desk-media" class="desk-audio-summary" role="status">Episode audio hasn’t been uploaded yet.</p>
<button id="desk-reupload" type="button" class="btn btn-outline" hidden>Upload episode again</button>
<input name="audioReviewed" type="checkbox" hidden/>
</fieldset></details>
<details id="desk-section-3" class="desk-section"><summary><span class="desk-step-number">3</span><span><span class="desk-step-title">Artwork & tracklist</span><span id="desk-progress-3" class="desk-step-hint">Prepare the episode for listeners</span></span><span class="desk-expand" aria-hidden="true">+</span></summary>    <fieldset class="desk-step"><legend class="sr-only">Artwork & tracklist</legend><div id="desk-art-drop" class="desk-art-drop" role="group" aria-label="Episode artwork"><p>Drop album art here</p><button id="desk-art-choose" type="button" class="btn btn-outline">Choose image</button><input id="desk-art-file" type="file" accept="image/jpeg,image/png,.jpg,.jpeg,.png" aria-label="Album artwork image" hidden/><img id="desk-art-preview" class="desk-art-preview" alt="Selected episode artwork preview" hidden/><button id="desk-art-remove" type="button" class="btn btn-ghost" hidden>Remove selected image</button></div><p id="desk-art-status" class="desk-small" role="status" aria-live="polite"></p><details><summary>Use an artwork link instead</summary><label>Episode artwork link<input name="art" type="url" class="input" placeholder="https://drive.google.com/…"/></label><a id="desk-art-link" class="link" target="_blank" rel="noreferrer" hidden>Open episode artwork ↗</a><p class="desk-small">Link imports require a directly downloadable Drive JPEG or PNG. A selected image takes priority.</p></details><label>Episode tracklist<textarea name="tracklist" class="textarea" rows="5" maxlength="20000" placeholder="Tracks in playing order"></textarea></label><input name="artReviewed" type="checkbox" hidden/></fieldset></details>
<details id="desk-section-4" class="desk-section"><summary><span class="desk-step-number">4</span><span><span class="desk-step-title">Review & schedule</span><span id="desk-progress-4" class="desk-step-hint">Check the destination and go live</span></span><span class="desk-expand" aria-hidden="true">+</span></summary>    <fieldset class="desk-step"><legend class="sr-only">Review & schedule</legend><p id="desk-ready-summary" class="desk-review-summary"></p><button id="desk-connect" type="button" class="btn btn-outline">Find show in AzuraCast</button><div id="desk-station" hidden><label>Show playlist<select id="desk-playlist" class="select"><option value="">Choose this show's playlist</option></select></label><label>Show audio folder<select id="desk-directory" class="select"><option value="">Choose this show's folder</option></select></label></div><p class="desk-small">Choose the existing playlist and folder for this show. Scheduling saves the episode details and artwork and enables the playlist for the confirmed time. The MP3 moves into the show folder when you archive it after airing.</p><p id="desk-schedule-comparison" role="status" aria-live="polite"></p><button id="desk-fix-schedule" type="button" class="btn btn-outline" hidden>Use confirmed time for playlist</button><p id="desk-station-status" role="status" aria-live="polite"></p></fieldset></details>

    <div class="desk-editor-footer"><p id="desk-confirm-description" class="desk-small"></p><p id="desk-form-status" role="status" aria-live="polite"></p><div class="desk-footer-actions"><button id="desk-back" type="button" class="btn btn-ghost" hidden>← Back</button><button id="desk-save" type="button" class="btn btn-ghost">Save draft &amp; close</button><button id="desk-continue" type="button" class="btn btn-accent" aria-describedby="desk-confirm-description">Confirm details &amp; continue to audio →</button><button id="desk-schedule" type="submit" class="btn btn-accent" disabled hidden>Schedule episode in AzuraCast</button></div></div>
   </form>
  </div></dialog>
  <dialog id="desk-archive-editor" class="modal"><div class="modal-box desk-editor">
   <div class="desk-section-heading"><div><p class="desk-kicker">EPISODE ARCHIVE</p><h2>Archive show</h2><p id="desk-archive-title" class="desk-small"></p></div><button id="desk-archive-close" type="button" class="btn btn-ghost" aria-label="Close archive show">✕</button></div>
   <form id="desk-archive-form">
    <fieldset id="desk-archive-fields" class="desk-step">
     <legend class="sr-only">Confirm episode to archive</legend>
     <div class="desk-fields"><label>Air date<input name="date" type="date" class="input" required/></label><label>Start time · Pacific<input name="start" type="time" class="input" required/></label><label>End time · Pacific<input name="end" type="time" class="input" required/></label></div>
     <label class="desk-check"><input name="dateConfirmed" type="checkbox" class="checkbox" required/>I confirm this episode’s air date and time</label>
     <button id="desk-archive-find" type="button" class="btn btn-outline">Find MP3 and playlists in AzuraCast</button>
     <label>Filter MP3s<input id="desk-archive-search" type="search" class="input" placeholder="Filename, show, or artist"/></label>
     <label>Episode MP3<select id="desk-archive-media" class="select" required><option value="">Find the episode MP3</option></select></label>
     <label>Show playlist<select id="desk-archive-playlist" class="select" required><option value="">Choose the show playlist</option></select></label>
     <p class="desk-small">Add this episode to Archives and heavy rotation, remove it from its show playlist, and disable that playlist. The air date is checked and saved as MM/DD/YYYY.</p>
    </fieldset>
    <p id="desk-archive-summary" class="desk-small"></p>
    <div class="desk-editor-footer"><p id="desk-archive-status" role="status" aria-live="polite"></p><button id="desk-archive" type="submit" class="btn btn-outline" disabled>Archive episode</button></div>
   </form>
  </div></dialog>
 </main>
</AdminLayout>
<script>import '../../lib/desk/client'</script>
<style>
 .desk-sidebar{display:flex;flex-direction:column;gap:24px;min-width:0}





 .desk-week-navigation{display:flex;flex-wrap:wrap;align-items:flex-end;gap:8px}
 .desk{max-width:var(--jetty-content-width);margin:32px auto 80px;padding:0 24px;font-size:16px;color:var(--jetty-text)}.desk-heading{display:flex;align-items:center;gap:40px;margin-bottom:32px}.desk-heading h1{font:600 2.5rem var(--jetty-font);line-height:1.15;margin:8px 0 12px}.desk-heading p{color:var(--jetty-text-muted)}.desk-kicker{font-size:.75rem;letter-spacing:.15em}.desk-toolbar{display:flex;flex-wrap:wrap;gap:12px;align-items:flex-end;margin:24px 0}.desk-toolbar label{display:flex;align-items:center;gap:12px}.desk-toolbar>span{display:flex;align-items:center;min-height:40px;font-size:.875rem;color:var(--jetty-text-muted);margin-right:auto}.desk input,.desk textarea,.desk select{width:100%;color:var(--jetty-inverse);background:var(--jetty-text);border-color:var(--jetty-border-strong);color-scheme:light}.desk input::placeholder,.desk textarea::placeholder{color:var(--jetty-field-muted);opacity:1}.desk select option{color:var(--jetty-inverse);background:var(--jetty-text)}.desk input:focus-visible,.desk textarea:focus-visible,.desk select:focus-visible{outline:2px solid var(--jetty-text);outline-offset:3px}.desk input[type=checkbox]{background:var(--jetty-text);color:var(--jetty-inverse);accent-color:var(--jetty-text)}.desk input:disabled,.desk textarea:disabled,.desk select:disabled{color:var(--jetty-field-muted);opacity:1}.desk input::file-selector-button{color:var(--jetty-inverse);background:var(--jetty-text-muted)}.desk-toolbar input{width:170px}.desk-columns{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:24px}.desk-panel{background:var(--jetty-surface);border:1px solid var(--jetty-border);padding:24px;border-radius:6px}.desk h2{font:600 1.65rem var(--jetty-font)}.desk h3{font:600 1.25rem var(--jetty-font);margin-bottom:12px}.desk-section-heading{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:20px}.desk-resources{height:fit-content}.desk-resources p{line-height:1.7;color:var(--jetty-text-muted);margin:16px 0}.desk-resources a{display:block;margin:16px 0}.desk hr{border-color:var(--jetty-border);margin:24px 0}.desk-small{font-size:.875rem;line-height:1.6;color:var(--jetty-text-subtle)}.desk-editor{max-width:720px;background:var(--jetty-overlay);color:var(--jetty-text);border:1px solid var(--jetty-border)}.desk form,#desk-station{display:flex;flex-direction:column;gap:18px}.desk #desk-station[hidden],.desk #desk-fix-schedule[hidden],.desk #desk-reupload[hidden]{display:none}.desk label{display:flex;flex-direction:column;gap:8px;font-size:.875rem}.desk-fields{display:grid;grid-template-columns:1fr 1fr;gap:16px}.desk-step{display:flex;flex-direction:column;gap:16px;margin-top:12px}.desk-step legend{font:600 1.15rem var(--jetty-font)}.desk-art-drop{border:2px dashed var(--jetty-border-strong);border-radius:6px;padding:20px;display:flex;flex-direction:column;align-items:center;gap:14px;text-align:center;background:var(--jetty-surface-inset)}.desk-art-drop.desk-dragging{border-color:var(--jetty-text);background:var(--jetty-hover)}.desk-art-preview{max-width:100%;max-height:320px;object-fit:contain;border-radius:4px}.desk-art-drop [hidden]{display:none}.desk-filename,.desk-audio-summary{overflow-wrap:anywhere}.desk-audio-summary{padding:12px;border:1px solid var(--jetty-border);background:var(--jetty-surface-inset)}.desk details summary{cursor:pointer;text-decoration:underline}.desk details .btn{margin-top:12px}.desk fieldset{border:1px solid var(--jetty-border);padding:16px}.desk legend{padding:0 8px}.desk .desk-check{flex-direction:row;align-items:center;margin:10px 0;line-height:1.5}.desk-check input{width:24px}.desk [role=status]{margin:16px 0;line-height:1.6}.desk :global(.desk-row){width:100%;display:grid;grid-template-columns:100px 1fr auto;gap:16px;align-items:center;text-align:left;padding:20px 0;border-bottom:1px solid var(--jetty-border)}.desk :global(.desk-row-actions){display:flex;flex-wrap:wrap;gap:8px}.desk :global(.desk-row time){font:14px var(--jetty-font);color:var(--jetty-text-muted)}.desk :global(.desk-row strong){display:block;font:600 1.15rem var(--jetty-font)}.desk :global(.desk-row small){display:block;font-size:14px;color:var(--jetty-text-subtle);margin-top:6px}.desk :global(.desk-badge){display:inline-block;margin-top:10px;font-size:14px;border:1px solid var(--jetty-border);padding:5px 10px;border-radius:4px}.desk :global(.desk-row button:focus-visible){outline:2px solid currentColor;outline-offset:5px}.desk :global(.desk-error){color:var(--jetty-error)}.desk :global(.desk-success){color:var(--jetty-text)}@media(max-width:850px){.desk-columns{grid-template-columns:1fr}.desk-heading{gap:24px}.desk :global(.desk-row){grid-template-columns:85px 1fr}.desk :global(.desk-row-actions){grid-column:2}}@media(max-width:520px){.desk{padding:0 16px}.desk-heading{align-items:start;flex-direction:column}.desk-heading h1{font-size:2rem}.desk-fields{grid-template-columns:1fr}.desk-panel{padding:18px}.desk-toolbar label{width:100%}.desk-toolbar>span{width:100%}}

 .desk-editor{max-width:780px;padding:0;border-radius:16px;max-height:90dvh}.desk-editor>.desk-section-heading{padding:24px 28px 18px;margin:0;border-bottom:1px solid var(--jetty-border)}.desk-editor h2{font-size:1.6rem}.desk-editor .desk-kicker{color:var(--jetty-text);margin-bottom:8px}.desk-editor form{gap:0;padding:0 28px}.desk-section{border-bottom:1px solid var(--jetty-border)}.desk .desk-section>summary{display:flex;align-items:center;gap:14px;list-style:none;text-decoration:none;padding:20px 0}.desk-section>summary::-webkit-details-marker{display:none}.desk-step-number{display:grid;place-items:center;flex-shrink:0;width:32px;height:32px;border:1px solid var(--jetty-border-strong);border-radius:50%;font-size:.875rem;color:var(--jetty-text-muted)}.desk-section[open] .desk-step-number{background:var(--jetty-text);border-color:var(--jetty-text);color:var(--jetty-inverse)}.desk-step-title{display:block;font-size:1rem;font-weight:600}.desk-step-hint{display:block;font-size:.8rem;color:var(--jetty-border-strong);margin-top:4px;line-height:1.5}.desk-expand{margin-left:auto;color:var(--jetty-text);font-size:1.3rem}.desk-section[open]>summary .desk-expand{transform:rotate(45deg)}.desk .desk-step{border:0;padding:0 0 24px;margin:0;gap:18px;min-width:0}.desk .desk-section details{padding:12px 14px;border:1px solid var(--jetty-border);border-radius:6px;background:var(--jetty-surface-inset)}.desk .desk-section details>summary{font-size:.875rem;text-decoration:none;color:var(--jetty-text-muted)}.desk .desk-section details[open]>summary{margin-bottom:16px}.desk .desk-section details label+label{margin-top:12px}.desk-art-drop{min-height:140px;border-color:var(--jetty-border-strong);background:var(--jetty-surface-inset)}.desk-editor-footer{position:sticky;bottom:0;background:var(--jetty-overlay);padding:16px 0;margin-top:12px;border-top:1px solid var(--jetty-border);z-index:2}.desk-footer-actions{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}.desk .desk-editor-footer [role=status]{font-size:.875rem;margin:0 0 12px}.desk [role=status]:empty{display:none}.desk-review-summary{background:var(--jetty-hover);border-left:3px solid var(--jetty-text);padding:14px;line-height:1.7;white-space:pre-line}.desk [hidden]{display:none!important}.desk summary:focus-visible{outline:2px solid var(--jetty-text);outline-offset:4px}.desk-section[data-complete=true] .desk-step-number{border-color:var(--jetty-text);color:var(--jetty-text)}.desk-section[data-complete=true][open] .desk-step-number{color:var(--jetty-inverse)}@media(max-width:520px){.desk-editor{max-width:100%;width:100%;max-height:96dvh;border-radius:12px 12px 0 0}.desk-editor>.desk-section-heading{padding:20px}.desk-editor form{padding:0 20px}.desk-footer-actions .btn{flex:1}.desk-step-hint{font-size:.75rem}}
.desk-import-row{display:flex;align-items:center;flex-wrap:wrap;gap:12px}.desk .desk-import-row [role=status]{margin:0;flex:1 1 200px}

.desk-audio-sources{display:flex;flex-wrap:wrap;gap:8px}.desk .desk-audio-sources .btn{margin-top:0;flex:1}
.desk .desk-audio-sources [aria-pressed=true]{background:var(--jetty-text);color:var(--jetty-inverse);border-color:var(--jetty-text)}
.desk #desk-confirm-description{margin:0 0 12px;max-width:65ch;line-height:1.5}
.desk-footer-actions{align-items:center}.desk #desk-save{margin-left:auto}.desk #desk-continue{white-space:normal;height:auto;min-height:48px;padding:12px 16px}
@media(max-width:520px){.desk-audio-sources{flex-direction:column}.desk #desk-continue,.desk #desk-schedule{flex-basis:100%}}
.desk-readiness-tools{display:flex;flex-wrap:wrap;align-items:end;gap:16px;margin:16px 0}.desk-readiness-tools label{flex:1;min-width:200px}.desk-readiness-note{margin:8px 0 16px}
 .desk :global(.desk-readiness){display:flex;flex-wrap:wrap;gap:6px 16px;margin-top:12px;padding:0;list-style:none;font-size:.875rem;color:var(--jetty-text-muted)}.desk :global(.desk-readiness li[data-complete=true]){color:var(--jetty-text)}
 @media(max-width:520px){.desk-readiness-tools label{min-width:100%}}
 .desk :global(.desk-row){grid-template-columns:100px minmax(0,1fr)}
 .desk :global(.desk-row-actions){grid-column:2}
 .desk :global(.desk-row strong){overflow-wrap:anywhere}
</style>
