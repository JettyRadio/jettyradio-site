---
import AdminLayout from '../../layouts/admin-layout.astro'
---
<AdminLayout>
    <main id="submissions" data-api={import.meta.env.PUBLIC_DESK_API_URL || ''}>
        <p class="eyebrow">𒀭 JETTY BACKSTAGE 𒀭</p>
        <h1>Submissions</h1>
        <p>Review incoming episodes, audio, and artwork before adding them to the scheduling desk.</p>
        <nav class="workflow-links" aria-label="Submission next steps"><a href="/backstage/desk">Prepare an episode on the Desk</a><a href="/backstage/djs">Find DJ contact details</a></nav>
        <div class="submission-tools">
            <label>Find a submission <input class="input" id="submission-search" type="search" placeholder="Show name, tracklist, or notes" disabled /></label>
            <label>Review status <select class="select" id="submission-filter" disabled><option value="all">All submissions</option><option value="new">Needs review</option><option value="reviewed">Reviewed</option></select></label>
            <button class="btn btn-outline" id="submission-refresh" disabled>Refresh</button>
        </div>
        <p id="submission-status" role="status" aria-live="polite">Sign in to load submissions.</p>
        <section id="submission-list" aria-label="Submitted episodes"></section>
        <button class="btn btn-outline" id="submission-more" hidden>Load older submissions</button>
        <p class="source-note">Review status is saved in Backstage. It does not schedule a broadcast or update the response sheet.</p>
        <noscript>Enable JavaScript to load private submissions.</noscript>
    </main>
</AdminLayout>
<script>
    import '../../lib/backstage/submissions-client'
</script>
<style is:global>
#submissions{max-width:1100px;margin:32px auto 80px;padding:0 24px;color:var(--jetty-text);line-height:1.6}#submissions h1{font-size:2.5rem;line-height:1.2;margin:8px 0 16px}#submissions .eyebrow{color:var(--jetty-text);letter-spacing:.12em;font-size:.875rem}#submissions .submission-tools{display:flex;flex-wrap:wrap;gap:16px;align-items:end;margin:28px 0 20px}#submissions label{display:flex;flex:1;flex-direction:column;gap:8px;min-width:200px}#submissions input,#submissions select{width:100%;color:var(--jetty-inverse);background:var(--jetty-text);color-scheme:light}#submissions #submission-status{margin:20px 0;color:var(--jetty-text-muted)}#submissions details{border:1px solid var(--jetty-border);background:var(--jetty-surface);margin:12px 0}#submissions summary{padding:20px;cursor:pointer;overflow-wrap:anywhere}#submissions summary span{display:block;color:var(--jetty-text);font-size:.875rem}#submissions .submission-body{padding:20px;border-top:1px solid var(--jetty-border)}#submissions dl{display:grid;grid-template-columns:180px minmax(0,1fr);gap:16px;margin-bottom:24px}#submissions dt{color:var(--jetty-text-subtle)}#submissions dd{white-space:pre-wrap;overflow-wrap:anywhere}#submissions a{color:var(--jetty-text);text-decoration:underline;text-underline-offset:3px}#submissions .source-note{color:var(--jetty-text-subtle);font-size:.875rem;margin-top:24px}#submissions [hidden]{display:none!important}@media(max-width:600px){#submissions{padding:0 16px}#submissions h1{font-size:2rem}#submissions dl{grid-template-columns:1fr;gap:6px}#submissions dd{margin-bottom:16px}}
</style>
