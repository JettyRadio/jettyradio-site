---
import { Icon } from 'astro-icon/components'
import { formatShowDate, getDjSlug } from '../utils'
interface Props {
  djs: string[]
  title: string
  date: Date
  setlist: string
  image: string
  downloadLink: string
  variant?: 'list' | 'card'
  duration?: string
}
const { djs, title, date, setlist, image, downloadLink, variant = 'list', duration } = Astro.props
---

<style lang="scss" define:vars={{ thumbnailSize: '130px' }}>
  .show {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    padding: 8px;
    gap: 16px;
    margin-bottom: 24px;
    font-family: sans-serif;
    padding-inline: 20px;
    @media (hover: hover) and (pointer: fine) {
      &:hover {
        .transport-button span {
          display: flex;
        }
      }
    }
  }

  .thumbnail {
    width: var(--thumbnailSize);
    height: var(--thumbnailSize);
  }
  .thumbnail-container {
    position: relative;
    height: var(--thumbnailSize);
    flex-shrink: 0;
  }
  .transport-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    height: var(--thumbnailSize);
    width: var(--thumbnailSize);
    align-items: center;
    display: flex;
    justify-content: center;
    background: transparent;
    border: none;
    color: white;
    opacity: 0.7;
    cursor: pointer;

    &:active {
      opacity: 0.9;
    }
  }
  .transport-button span {
    display: none;
    align-items: center;
    justify-content: center;
    height: 50px;
    width: 50px;
    background: #0009;
    border-radius: 50%;
  }
  .show-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    justify-content: space-between;
    min-height: var(--thumbnailSize);
  }
  .show-date {
    font-size: 0.75em;
    font-style: italic;
    color: #aaa;
  }
  .dj {
    a {
      font-size: 0.8em;
      color: #ccc;
    }
  }
  .details {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.25;
    gap: 2px;
  }
  .setlist {
    padding-block: 8px;
    summary {
      cursor: pointer;
      font-size: 0.8em;
    }

    pre {
      font-size: 12px;
    }
  }
  .button-group {
    display: flex;
    gap: 8px;
  }
  .icon-button {
    height: 30px;
    width: 30px;
    border: 1px solid #aaa;
    border-radius: 50%;
    display: flex;
    align-items: center;
    background: transparent;
    color: #fff;
    justify-content: center;
    font-size: 34px;
    cursor: pointer;
    &:hover {
      background: #fff2;
    }
  }
  .show.card {
    flex-direction: column;
    height: 100%;
    margin: 0;
    padding: 0;
    gap: 0;
    border: 1px solid #ffffff25;
    background: #141815;
    .thumbnail-container {
      width: 100%;
      height: auto;
      aspect-ratio: 1;
      overflow: hidden;
      background: #252e27;
    }
    .thumbnail {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .transport-button {
      width: 100%;
      height: 100%;
      opacity: 1;
    }
    .transport-button span {
      display: flex;
      width: 56px;
      height: 56px;
      background: #101b11e6;
      border: 1px solid #d7edbd;
      color: #d7edbd;
    }
    .transport-button:hover span {
      background: #d7edbd;
      color: #101b11;
    }
    .show-content {
      width: 100%;
      flex: 1;
      padding: 20px;
      gap: 20px;
    }
    .details { gap: 10px; }
    .show-date {
      color: #b4bdb3;
      font-size: 0.8125rem;
      font-style: normal;
    }
    .show-title {
      font-family: Georgia, serif;
      font-size: 1.5rem;
      line-height: 1.15;
      overflow-wrap: anywhere;
    }
    .dj { margin-top: 8px; }
    .dj a { font-size: 0.875rem; color: #d7edbd; }
    .button-group {
      align-items: center;
      border-top: 1px solid #ffffff20;
      padding-top: 14px;
    }
    .icon-button { width: 40px; height: 40px; border-color: #ffffff40; }
    .duration { margin-left: auto; color: #b4bdb3; font-size: 0.8125rem; font-family: monospace; }
    .setlist { width: 100%; }
    .setlist summary { font-size: 0.875rem; }
    .setlist pre { white-space: pre-wrap; overflow-wrap: anywhere; font-size: 0.875rem; }
    :is(button, a, summary):focus-visible { outline: 2px solid #d7edbd; outline-offset: 4px; }
    .transport-button:focus-visible { outline-offset: -4px; }
  }
</style>
<div class:list={['show', { card: variant === 'card' }]}>
  <div class="thumbnail-container">
    <button
      class="play-show-btn transport-button"
      aria-label={`Play ${title}`}
      data-src={downloadLink}
      data-thumbnail={image}
      data-title={title}
      data-dj={djs.join(' & ')}
      ><span><Icon name="play" size="30" /></span></button
    >

    <img src={image || '/apple-touch-icon.png'} class="thumbnail" alt="" loading="lazy" />
  </div>
  <div class="show-content">
    <div class="details">
      <div class="show-date">{formatShowDate(date)}</div>
      <div class="title">
        {variant === 'card' ? <h2 class="show-title">{title}</h2> : <div class="show-title">{title}</div>}
        <div class="dj">
          {
            djs.map((dj, i) => (
              <>
                <a class="link" href={`/dj/${getDjSlug(dj)}`}>
                  {dj}
                </a>
                {i < djs.length - 1 && ', '}
              </>
            ))
          }
        </div>
      </div>
      {
        setlist && (
          <details class="setlist">
            <summary>Setlist</summary>
            <pre>{setlist}</pre>
          </details>
        )
      }
    </div>
    <div class="button-group">
      <a class="download icon-button" aria-label={`Download ${title}`} href={downloadLink}
        ><Icon name="download" size="18" /></a
      >
      <button
        class="play-show-btn icon-button"
        aria-label={`Play ${title}`}
        data-src={downloadLink}
        data-thumbnail={image}
        data-title={title}
        data-dj={djs.join(' & ')}><Icon name="play" /></button
      >
      {duration && <span class="duration" aria-label={`Duration ${duration}`}>{duration}</span>}
    </div>
  </div>
</div>
<script>
  import {
    loadPlayer,
    togglePlayer,
    setPlayerInfo,
    unloadLiveRadioInfo,
  } from '../lib/player'
  function setupButtons() {
    document.querySelectorAll('.play-show-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const data = (btn as HTMLElement).dataset
        unloadLiveRadioInfo()
        loadPlayer(data.src ?? '')
        setPlayerInfo({
          thumbnail: data.thumbnail ?? '',
          title: data.title ?? '',
          dj: data.dj ?? '',
          live: false,
        })
        togglePlayer(true)
      })
    })
  }

  document.addEventListener('astro:page-load', setupButtons)
</script>
